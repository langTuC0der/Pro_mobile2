<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- 1. BẢN ĐỒ (Lớp dưới cùng) -->
    <!-- Dùng OSMDroid (osmdroid) miễn phí và ổn định -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. THANH TRẠNG THÁI (Top Bar) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Thời tiết -->
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☁ 20°"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:gravity="center"/>
        </androidx.cardview.widget.CardView>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

        <!-- Nút Bật/Tắt Nhận việc -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvStatus"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="16dp">
                <View
                    android:id="@+id/viewStatusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_dot_red"/>
                <TextView
                    android:id="@+id/tvStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Không nhận việc"
                    android:textColor="#D32F2F"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

        <!-- Chuông thông báo -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_white"
            android:elevation="4dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_popup_reminder"
                android:layout_gravity="center"
                app:tint="#00A651"/>
        </FrameLayout>
    </LinearLayout>

    <!-- 3. POPUP ĐƠN HÀNG (Mặc định ẩn - visibility="gone") -->
    <!-- Khi có đơn, Java sẽ set visibility="visible" -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvOrderPopup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Dòng 1: Loại đơn + Giá tiền -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_compass"
                        app:tint="#00A651"/>

                    <!-- ID: tvPopupDistance -->
                    <TextView
                        android:id="@+id/tvPopupDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" 2.5 km"
                        android:textStyle="bold"
                        android:textColor="#757575"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>

                <!-- ID: tvPopupPrice -->
                <TextView
                    android:id="@+id/tvPopupPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="99.000đ"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#00A651"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginBottom="12dp"/>

            <!-- Dòng 2: Điểm đón (ID: tvPopupPickup) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="#2196F3"
                    android:textSize="18sp"/>

                <TextView
                    android:id="@+id/tvPopupPickup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Số 01 Duy Tân, Cầu Giấy"
                    android:textStyle="bold"
                    android:textColor="#000"
                    android:textSize="16sp"/>
            </LinearLayout>

            <!-- Dòng 3: Điểm đến (ID: tvPopupDropoff) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="#D32F2F"
                    android:textSize="18sp"/>

                <TextView
                    android:id="@+id/tvPopupDropoff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aeon Mall Hà Đông"
                    android:textStyle="bold"
                    android:textColor="#000"
                    android:textSize="16sp"/>
            </LinearLayout>

            <!-- Dòng 4: Các nút bấm -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnReject"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bỏ qua"
                    android:textColor="#757575"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground"/>

                <Button
                    android:id="@+id/btnAcceptOrder"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1.5"
                    android:text="Nhận đơn ngay"
                    android:backgroundTint="#00A651"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 4. NÚT VỊ TRÍ CỦA TÔI -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMyLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@android:drawable/ic_menu_mylocation"
        app:backgroundTint="#FFFFFF"
        app:tint="#000000"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>