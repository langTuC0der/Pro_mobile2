<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chỉnh sửa thông tin"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#00A651"
        android:layout_marginBottom="24dp"/>

    <!-- Họ và tên -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Họ và tên"
        android:textStyle="bold"/>
    <EditText
        android:id="@+id/edtEditFullName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập họ tên mới"
        android:layout_marginBottom="16dp"/>

    <!-- Email (Read-only) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email (không thể thay đổi)"
        android:textStyle="bold"/>
    <EditText
        android:id="@+id/edtEditEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:textColor="#757575"
        android:layout_marginBottom="16dp"/>

    <!-- Số điện thoại (Read-only) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Số điện thoại (không thể thay đổi)"
        android:textStyle="bold"/>
    <EditText
        android:id="@+id/edtEditPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:textColor="#757575"
        android:layout_marginBottom="16dp"/>

    <!-- Mật khẩu mới -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mật khẩu mới (bỏ trống nếu không đổi)"
        android:textStyle="bold"/>
    <EditText
        android:id="@+id/edtEditPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập mật khẩu mới"
        android:inputType="textPassword"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnSaveChanges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lưu thay đổi"
        android:backgroundTint="#00A651"
        android:textColor="#FFFFFF"/>

</LinearLayout>
